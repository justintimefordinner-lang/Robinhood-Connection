[Unit]
Description=Robinhood bridge auto-push (wheel toolkit)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/wheel-toolkit/robinhood-bridge
ExecStart=/home/pi/wheel-toolkit/robinhood-bridge/.venv/bin/python auto_push.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
