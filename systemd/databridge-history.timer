[Unit]
Description=Run databridge-history.service daily after the market close

[Timer]
# 4:15pm ET is 20:15 UTC during EDT (summer) / 21:15 UTC during EST (winter).
# systemd doesn't know about ET DST, so this uses UTC; adjust OnCalendar below
# twice a year, or point it at America/New_York if your Pi's timezone is set
# to ET (then just use 16:15 local time instead).
OnCalendar=Mon..Fri 20:15:00
Persistent=true

[Install]
WantedBy=timers.target
