[Unit]
Description=Robinhood bridge auto-push (wheel toolkit)
After=network.target

[Service]
Type=simple
User=jimmydaux
WorkingDirectory=/home/jimmydaux/JerStock/databridge
ExecStart=/home/jimmydaux/JerStock/databridge/.venv/bin/python auto_push.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
