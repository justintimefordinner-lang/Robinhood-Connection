# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env.

# --- Robinhood login ---
ROBINHOOD_USERNAME=your_email_or_username
ROBINHOOD_PASSWORD=your_password

# Optional: only needed for UNATTENDED runs (systemd/cron with no terminal to
# type an MFA code into). This is the base32 *secret key* Robinhood shows once
# when you enable "Authenticator app" MFA in Security settings - not the
# rotating 6-digit code. Leave blank to be prompted interactively on first run.
ROBINHOOD_TOTP_SECRET=

# --- Where to write JSON the app reads (point at the app's data/ folder) ---
APP_DATA_DIR=/home/jimmydaux/JerStock/appfiles/data

# --- auto_push.py cadences (seconds; 0 disables that target) ---
APP_PUSH_INTERVAL=60
RESEARCH_PUSH_INTERVAL=900
AM_REPORT_PUSH_INTERVAL=1800
AM_LADDER_PUSH_INTERVAL=300
